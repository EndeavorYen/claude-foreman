{
  "description": "foreman：context 很大且快取過期、或 context 超過門檻時提醒使用者交接；新 session 指向交接檔",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/remind.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/remind.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/remind.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/remind.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/remind.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/scripts/remind.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}